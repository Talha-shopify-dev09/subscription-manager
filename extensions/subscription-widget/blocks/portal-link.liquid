{% schema %}
{
  "name": "Socoba App Block",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Button Text",
      "default": "Manage Subscriptions"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}

{% comment %} 
  PERFORMANCE FIX: Only render this script if we are on the Account page.
  This keeps the rest of the store fast.
{% endcomment %}
{% if request.path contains '/account' %}
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      
      // 1. Safe Variable Assignment (Prevents syntax errors from quotes)
      const btnText = "{{ block.settings.link_text | escape }}";
      const btnBg = "{{ block.settings.btn_color }}";
      const btnTextColor = "{{ block.settings.text_color }}";
      // Ensure this matches your TOML proxy URL exactly
      const portalUrl = "/apps/subscription-manager/portal"; 

      // 2. Build the Button DOM Element cleanly
      const btnContainer = document.createElement('div');
      btnContainer.className = "socoba-subscription-link"; // Class for checking duplicates
      btnContainer.style.margin = "20px 0";
      
      const link = document.createElement('a');
      link.href = portalUrl;
      link.innerText = btnText;
      link.style.backgroundColor = btnBg;
      link.style.color = btnTextColor;
      link.style.padding = "10px 20px";
      link.style.textDecoration = "none";
      link.style.borderRadius = "4px";
      link.style.fontWeight = "600";
      link.style.display = "inline-block";
      link.style.transition = "opacity 0.2s";
      
      link.onmouseover = function() { this.style.opacity = "0.8"; };
      link.onmouseout = function() { this.style.opacity = "1"; };

      btnContainer.appendChild(link);

      // 3. Safer Targeting Strategy
      // We look for specific account page elements to avoid injecting into the Header/Logo
      const candidates = [
        document.querySelector('.customer__title'),      // Dawn Theme / 2.0 Themes
        document.querySelector('.account-header h1'),    // Common Theme Structure
        document.querySelector('.template-customers-account h1'), // Legacy Themes
        document.querySelector('main h1'),               // Generic Main Body Header
        document.querySelector('#customer_logout_link')  // Fallback: Put it near logout
      ];

      // 4. Inject after the first valid match found
      for (let i = 0; i < candidates.length; i++) {
        if (candidates[i]) {
          // Check if we already added it (prevents duplicates)
          if (!document.querySelector('.socoba-subscription-link')) {
            candidates[i].insertAdjacentElement('afterend', btnContainer);
            console.log("Socoba: Portal link injected.");
          }
          break; // Stop after first successful injection
        }
      }
    });
  </script>
{% endif %}
