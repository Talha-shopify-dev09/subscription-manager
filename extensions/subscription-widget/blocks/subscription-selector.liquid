{% schema %}
{
  "name": "Subscription Selector",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe & Save"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}

<style>
  .sw-container {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    margin: 24px 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    font-family: inherit;
  }

  .sw-title {
    margin: 0 0 16px 0;
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    text-align: center;
  }

  /* Grid Layout: Dynamic based on plan count, max 3 columns */
  .sw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  /* Plan Card Styles */
  .sw-label { position: relative; cursor: pointer; }
  .sw-input { position: absolute; opacity: 0; width: 0; height: 0; }

  .sw-card {
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px 10px;
    text-align: center;
    transition: all 0.2s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #fff;
    min-height: 110px;
  }

  /* Hover State */
  .sw-label:hover .sw-card {
    border-color: #9ca3af;
    transform: translateY(-2px);
  }

  /* Selected State */
  .sw-input:checked + .sw-card {
    border-color: {{ section.settings.accent_color }};
    background-color: #f9fafb;
    box-shadow: 0 0 0 1px {{ section.settings.accent_color }};
  }

  /* Typography */
  .sw-duration {
    font-weight: 700;
    font-size: 15px;
    display: block;
    margin-bottom: 4px;
    color: #374151;
    text-transform: capitalize;
  }
  
  .sw-price {
    font-size: 15px;
    color: #111827;
  }

  .sw-discount {
    font-size: 12px;
    color: #10b981; /* Green for savings */
    font-weight: 600;
    margin-top: 4px;
  }

  /* "Best Value" Badge */
  .sw-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: {{ section.settings.accent_color }};
    color: #fff;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 12px;
    white-space: nowrap;
    z-index: 2;
  }

  /* Button */
  .sw-btn {
    width: 100%;
    background-color: {{ section.settings.accent_color }};
    color: #fff;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .sw-btn:hover { opacity: 0.9; }
  
  /* Error Message */
  .sw-error {
    color: #ef4444;
    font-size: 13px;
    margin-top: 10px;
    text-align: center;
    display: none;
    background: #fef2f2;
    padding: 8px;
    border-radius: 4px;
  }
</style>

<div id="subscription-widget-{{ product.id }}">
  <div style="padding: 20px; text-align: center; color: #6b7280; background: #f9fafb; border-radius: 8px;">
    Loading options...
  </div>
</div>

<script>
(async function() {
  const container = document.getElementById('subscription-widget-{{ product.id }}');
  const productId = '{{ product.id }}';
  const variantId = {{ product.selected_or_first_available_variant.id }};

  // Extract ID number from "gid://..."
  function cleanId(id) {
    if (!id) return null;
    const str = id.toString();
    const parts = str.split('/');
    return parts[parts.length - 1]; 
  }

  try {
    const response = await fetch(`/apps/subscription-manager/api/subscription/${productId}`);
    if (!response.ok) { container.style.display = 'none'; return; }

    const data = await response.json();
    if (!data.subscription || !data.subscription.enabled) {
      container.style.display = 'none';
      return;
    }

    const sub = data.subscription;
    const originalPrice = parseFloat('{{ product.price | money_without_currency | remove: "," }}');

    // 1. PARSE DYNAMIC PLANS
    let plans = [];
    try {
        plans = JSON.parse(sub.plansData || '[]');
    } catch(e) {
        console.error("Error parsing plansData", e);
    }
    
    // 2. PARSE SHOPIFY IDs
    let shopifyIds = {};
    try {
        shopifyIds = JSON.parse(sub.shopifyPlanIds || '{}');
    } catch(e) {
        console.error("Error parsing shopifyPlanIds", e);
    }

    // Find Max Discount for badge
    const maxDiscount = Math.max(...plans.map(p => parseFloat(p.discount || 0)));

    // 3. GENERATE HTML LOOP
    let plansHtml = '';

    if (plans.length === 0) {
        // Fallback if no dynamic plans exist yet
        container.style.display = 'none';
        return;
    }

    plans.forEach((plan, index) => {
        // Calculate Discounted Price
        const discount = parseFloat(plan.discount || 0);
        const discountedPrice = (originalPrice * (1 - discount/100)).toFixed(2);
        
        // Match Shopify ID (Key is 1-based index)
        const key = (index + 1).toString(); 
        const sellingPlanId = cleanId(shopifyIds[key]);
        
        // Determine "Best Value"
        const isBestValue = (discount === maxDiscount && discount > 0);
        const isChecked = index === 0 ? 'checked' : '';

        // Format Label (e.g. "Every 2 Weeks")
        const label = `Every ${plan.intervalCount} ${plan.interval.toLowerCase()}${plan.intervalCount > 1 ? 's' : ''}`;

        plansHtml += `
           <label class="sw-label">
             <input type="radio" class="sw-input" name="sub_plan" value="${sellingPlanId || ''}" ${isChecked}>
             <div class="sw-card">
               ${ isBestValue ? '<span class="sw-badge">Best Value</span>' : '' }
               <span class="sw-duration">${label}</span>
               <span class="sw-price">${discountedPrice}</span>
               <div class="sw-discount">Save ${discount}%</div>
             </div>
           </label>
        `;
    });

    // 4. RENDER WIDGET
    container.innerHTML = `
      <div class="sw-container">
        <h3 class="sw-title">${ '{{ section.settings.heading }}' }</h3>
        
        <div class="sw-grid">
           ${plansHtml}
        </div>

        <button id="btn-add-sub" class="sw-btn">
            Add Subscription to Cart
        </button>
        <p id="error-msg" class="sw-error"></p>
      </div>
    `;

    // 5. EVENT LISTENER
    document.getElementById('btn-add-sub').addEventListener('click', async function(e) {
        const btn = e.target;
        const errorMsg = document.getElementById('error-msg');
        const selected = container.querySelector('input[name="sub_plan"]:checked');
        
        errorMsg.style.display = 'none';

        if(!selected || !selected.value) {
            errorMsg.innerText = "Error: Plan ID missing. Please edit/save the plan in App Admin.";
            errorMsg.style.display = 'block';
            return;
        }

        const planId = parseInt(selected.value);

        if (isNaN(planId)) {
             errorMsg.innerText = "Error: Invalid Plan ID format.";
             errorMsg.style.display = 'block';
             return;
        }

        const originalText = btn.innerText;
        btn.innerText = "Adding...";
        btn.style.opacity = "0.7";
        
        try {
            const cartResponse = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    items: [{
                        id: variantId,
                        quantity: 1,
                        selling_plan: planId 
                    }]
                })
            });

            const cartData = await cartResponse.json();

            if (!cartResponse.ok) {
                btn.innerText = originalText;
                btn.style.opacity = "1";
                errorMsg.innerText = `Error: ${cartData.description || "Issue adding to cart"}`;
                errorMsg.style.display = 'block';
                return;
            }
            window.location.href = '/cart';

        } catch (err) {
            console.error(err);
            btn.innerText = "Error";
            setTimeout(() => { btn.innerText = originalText; btn.style.opacity = "1"; }, 2000);
        }
    });

  } catch (err) {
    console.error("Widget Error", err);
    container.style.display = 'none';
  }
})();
</script>