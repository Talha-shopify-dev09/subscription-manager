{% schema %}
{
  "name": "Subscription Options",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Purchase Options" },
    { "type": "color", "id": "accent_color", "label": "Button Color", "default": "#000000" }
  ]
}
{% endschema %}

<div id="subscription-widget-{{ product.id }}" class="sw-wrapper" data-product-id="{{ product.id }}">
  <div style="padding: 15px; text-align: center; color: #6b7280; font-size: 0.9em;">Loading options...</div>
</div>

<style>
  .sw-wrapper { border: none; max-width: 100%; background: transparent; margin: 24px 0; font-family: inherit; }
  .sw-header { padding-bottom: 12px; font-size: 16px; font-weight: 600; color: #111; }
  
  .sw-option-row { 
    display: flex; align-items: flex-start; gap: 12px; padding: 16px; 
    border: 1px solid #e5e7eb; border-radius: 8px; margin-bottom: 12px; 
    background: #fff; cursor: pointer; transition: all 0.2s ease; 
  }
  .sw-option-row:hover { border-color: #9ca3af; }
  .sw-option-row.selected { border-color: #111; border-width: 2px; background: #fafafa; }
  
  .sw-radio-container { padding-top: 2px; }
  .sw-radio-container input[type="radio"] { width: 18px; height: 18px; accent-color: #111; cursor: pointer; }
  
  .sw-info { flex: 1; display: flex; flex-direction: column; }
  .sw-top-line { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .sw-label-text { font-size: 15px; font-weight: 500; color: #111; }
  .sw-price-text { font-size: 15px; font-weight: 600; color: #111; }
  
  .sw-badge { 
    background: #111; color: #fff; font-size: 10px; font-weight: 700; 
    padding: 2px 8px; border-radius: 12px; margin-left: 8px; text-transform: uppercase;
  }
  
  .sw-plan-selector { margin-top: 12px; padding-top: 12px; border-top: 1px solid #e5e5e5; display: none; }
  .sw-select { 
    width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; 
    font-size: 14px; background: #fff; color: #333; cursor: pointer;
  }
  
  .sw-btn { 
    width: 100%; background-color: {{ section.settings.accent_color }}; color: #fff; 
    padding: 12px; border: none; border-radius: 8px; cursor: pointer; 
    font-weight: 600; font-size: 16px; margin-top: 12px; transition: opacity 0.2s;
  }
  .sw-btn:hover { opacity: 0.9; }
  .sw-error { color: #dc2626; font-size: 13px; margin-top: 8px; text-align: center; display: none; }
</style>

<script>
(async function() {
  const container = document.getElementById('subscription-widget-{{ product.id }}');
  const productId = '{{ product.id }}';
  // Note: We use the initial price as a base, but dynamic variant pricing usually requires listening to theme events.
  // For simplicity, we calculate based on the current product price liquid output.
  const productPriceCents = {{ product.price }}; 
  const currencySymbol = '{{ cart.currency.symbol }}';

  function formatMoney(cents) { 
    return currencySymbol + (cents / 100).toFixed(2); 
  }

  // --- HELPER: Get Current Variant ID ---
  // This is the FIX for the static variant issue.
  function getCurrentVariantId() {
    const urlParams = new URLSearchParams(window.location.search);
    const variantFromUrl = urlParams.get('variant');
    if (variantFromUrl) return parseInt(variantFromUrl);
    
    // Fallback to the first available variant if URL param is missing
    return {{ product.selected_or_first_available_variant.id }};
  }

  try {
    // 1. Fetch Plan Data from your secure App Proxy
    const response = await fetch(`/apps/subscription-manager/api/subscription/${productId}`);
    
    if (!response.ok) { 
      console.warn("Subscription API unreachable"); 
      container.style.display = 'none'; 
      return; 
    }
    
    const data = await response.json();
    if (!data.subscription || !data.subscription.enabled) { 
      container.style.display = 'none'; 
      return; 
    }

    const sub = data.subscription;
    const plans = sub.plansData;
    const shopifyIds = sub.shopifyPlanIds || {};

    if (!plans || plans.length === 0) { 
      container.style.display = 'none'; 
      return; 
    }

    // 2. Build the UI
    const firstPlan = plans[0];
    const firstDiscount = parseFloat(firstPlan.discount || 0);
    const discountedPriceCents = productPriceCents * (1 - firstDiscount / 100);

    let html = `
      <div class="sw-header">{{ section.settings.heading }}</div>
      
      <div class="sw-option-row selected" id="opt-row-onetime" onclick="selectOption('onetime')">
        <div class="sw-radio-container">
          <input type="radio" name="purchase_option" value="onetime" checked>
        </div>
        <div class="sw-info">
          <div class="sw-top-line">
            <span class="sw-label-text">One-time purchase</span>
            <span class="sw-price-text">${formatMoney(productPriceCents)}</span>
          </div>
        </div>
      </div>

      <div class="sw-option-row" id="opt-row-sub" onclick="selectOption('subscription')">
        <div class="sw-radio-container">
          <input type="radio" name="purchase_option" value="subscription">
        </div>
        <div class="sw-info">
          <div class="sw-top-line">
            <span class="sw-label-text">
              Subscribe & Save
              <span class="sw-badge">Save <span id="max-save-display">${firstDiscount}</span>%</span>
            </span>
            <span class="sw-price-text" id="sub-price-display">${formatMoney(discountedPriceCents)}</span>
          </div>
          
          <div class="sw-plan-selector" id="plan-selector-box" onclick="event.stopPropagation()">
            <select class="sw-select" id="selling-plan-dropdown" onchange="updateUI()">
    `;

    plans.forEach((plan) => {
      // Key matching logic must match app.subscriptions.jsx
      const key = `${plan.interval}_${plan.intervalCount}`;
      const rawId = shopifyIds[key];
      
      // Extract numeric ID from GID (gid://shopify/SellingPlan/12345 -> 12345)
      const cleanId = rawId ? rawId.split('/').pop() : '';
      
      if (cleanId) {
        const discount = parseFloat(plan.discount || 0);
        const priceCents = productPriceCents * (1 - discount/100);
        
        html += `<option value="${cleanId}" data-discount="${discount}" data-price="${priceCents}">
          Every ${plan.intervalCount} ${plan.interval.toLowerCase()}(s) - Save ${discount}%
        </option>`;
      }
    });

    html += `
            </select>
          </div>
        </div>
      </div>

      <div class="sw-footer">
        <button id="btn-add-to-cart" class="sw-btn" onclick="addToCart(event)">Add to Cart</button>
        <p id="sw-error-msg" class="sw-error"></p>
      </div>`;

    container.innerHTML = html;

    // 3. Define Logic
    let currentMode = 'onetime';
    let currentPlanId = '';

    window.selectOption = function(type) {
      currentMode = type;
      
      // Visual updates
      document.getElementById('opt-row-onetime').classList.toggle('selected', type === 'onetime');
      document.getElementById('opt-row-sub').classList.toggle('selected', type === 'subscription');
      
      // Radio updates
      document.querySelector(`input[value="${type}"]`).checked = true;
      
      // Dropdown visibility
      const dropdown = document.getElementById('plan-selector-box');
      dropdown.style.display = type === 'subscription' ? 'block' : 'none';
      
      if (type === 'subscription') updateUI();
    };

    window.updateUI = function() {
      const dropdownSelect = document.getElementById('selling-plan-dropdown');
      if (!dropdownSelect) return;
      
      currentPlanId = dropdownSelect.value;
      const selectedOption = dropdownSelect.options[dropdownSelect.selectedIndex];
      
      if (selectedOption) {
        const price = parseFloat(selectedOption.getAttribute('data-price'));
        const discount = selectedOption.getAttribute('data-discount');
        
        document.getElementById('sub-price-display').innerText = formatMoney(price);
        document.getElementById('max-save-display').innerText = discount;
      }
    };

    window.addToCart = async function(e) {
      if(e) e.preventDefault();
      
      const btn = document.getElementById('btn-add-to-cart');
      const errorMsg = document.getElementById('sw-error-msg');
      const originalText = btn.innerText;
      
      errorMsg.style.display = 'none';
      btn.innerText = "Adding...";
      btn.disabled = true;

      // DYNAMIC VARIANT ID FETCH
      const variantId = getCurrentVariantId();
      
      const payload = { 
        id: variantId, 
        quantity: 1 
      };

      if (currentMode === 'subscription' && currentPlanId) {
        payload.selling_plan = parseInt(currentPlanId);
      }

      try {
        const res = await fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [payload] })
        });

        if (res.ok) {
          // Redirect to cart or open cart drawer depending on theme
          window.location.href = '/cart';
        } else {
          const errData = await res.json();
          throw new Error(errData.description || "Couldn't add item");
        }
      } catch (err) {
        btn.innerText = originalText;
        btn.disabled = false;
        errorMsg.innerText = err.message;
        errorMsg.style.display = 'block';
      }
    };
    
    // Initialize UI state
    updateUI();

  } catch (err) {
    console.error("Widget load error:", err);
    container.style.display = 'none';
  }
})();
</script>