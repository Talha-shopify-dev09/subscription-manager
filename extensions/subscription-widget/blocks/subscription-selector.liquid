{% schema %}
{
  "name": "Subscription Options",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Purchase Options"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}

<div id="subscription-widget-{{ product.id }}" class="sw-wrapper">
  <div style="padding: 15px; text-align: center; color: #6b7280; font-size: 0.9em;">
    Loading options...
  </div>
</div>

<style>
  .sw-wrapper {
    margin: 20px 0;
    font-family: inherit;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  
  .sw-header {
    background: #f9fafb;
    padding: 10px 15px;
    border-bottom: 1px solid #e5e7eb;
    font-weight: 600;
    font-size: 0.95rem;
    color: #374151;
  }

  /* Option Rows */
  .sw-option-row {
    display: flex;
    align-items: flex-start;
    padding: 15px;
    cursor: pointer;
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.2s;
  }
  .sw-option-row:last-child { border-bottom: none; }
  .sw-option-row:hover { background-color: #f9fafb; }
  
  .sw-radio-container {
    margin-right: 12px;
    margin-top: 2px;
  }
  
  .sw-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  .sw-top-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .sw-label-text { font-weight: 600; color: #111827; font-size: 0.95rem; }
  .sw-price-text { color: #374151; font-size: 0.95rem; }

  /* Dropdown Area */
  .sw-plan-selector {
    margin-top: 10px;
    display: none; /* Hidden by default */
    padding-top: 10px;
    border-top: 1px solid #f3f4f6;
  }
  
  .sw-select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.9rem;
    background-color: #fff;
    color: #374151;
  }

  .sw-badge {
    background-color: #d1fae5;
    color: #059669;
    font-size: 0.75rem;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
    margin-left: 8px;
  }
</style>

<script>
(async function() {
  const container = document.getElementById('subscription-widget-{{ product.id }}');
  const productId = '{{ product.id }}';
  const productPrice = {{ product.price }}; // Cents
  const currencySymbol = '{{ cart.currency.symbol }}';

  // Helper to format money
  function formatMoney(cents) {
    return currencySymbol + (cents / 100).toFixed(2);
  }

  // 1. Fetch Subscription Data
  try {
    const response = await fetch(`/apps/subscription-manager/api/subscription/${productId}`);
    if (!response.ok) { container.style.display = 'none'; return; }

    const data = await response.json();
    if (!data.subscription || !data.subscription.enabled) {
      container.style.display = 'none';
      return;
    }

    const sub = data.subscription;
    
    // Parse Plans & IDs
    let plans = [], shopifyIds = {};
    try {
      plans = JSON.parse(sub.plansData || '[]');
      shopifyIds = JSON.parse(sub.shopifyPlanIds || '{}');
    } catch(e) { console.error(e); }

    if (plans.length === 0) { container.style.display = 'none'; return; }

    // 2. Build HTML
    // We inject a hidden input named 'selling_plan' that product forms automatically pick up
    let html = `
      <div class="sw-header">{{ section.settings.heading }}</div>
      
      <label class="sw-option-row" onclick="selectOption('onetime')">
        <div class="sw-radio-container">
          <input type="radio" name="purchase_option" value="onetime" checked>
        </div>
        <div class="sw-info">
          <div class="sw-top-line">
            <span class="sw-label-text">One-time purchase</span>
            <span class="sw-price-text">${formatMoney(productPrice)}</span>
          </div>
        </div>
      </label>

      <label class="sw-option-row" onclick="selectOption('subscription')">
        <div class="sw-radio-container">
          <input type="radio" name="purchase_option" value="subscription">
        </div>
        <div class="sw-info">
          <div class="sw-top-line">
            <span class="sw-label-text">
              Subscribe & Save <span class="sw-badge">Save <span id="max-save-display">10</span>%</span>
            </span>
            <span class="sw-price-text" id="sub-price-display">${formatMoney(productPrice)}</span>
          </div>
          
          <div class="sw-plan-selector" id="plan-selector-box">
             <select class="sw-select" id="selling-plan-dropdown" onchange="updateHiddenInput()">
    `;

    // Loop Plans for Dropdown
    plans.forEach((plan, index) => {
        const key = (index + 1).toString();
        // Extract numeric ID from gid://shopify/SellingPlan/12345
        const rawId = shopifyIds[key];
        const cleanId = rawId ? rawId.split('/').pop() : '';
        
        const discount = parseFloat(plan.discount || 0);
        const price = (productPrice * (1 - discount/100));
        
        const label = `Every ${plan.intervalCount} ${plan.interval.toLowerCase()}(s)`;

        html += `<option value="${cleanId}" data-discount="${discount}" data-price="${price}">${label} - Save ${discount}%</option>`;
    });

    html += `
             </select>
          </div>
        </div>
      </label>

      <input type="hidden" name="selling_plan" id="final-selling-plan-input" value="">
    `;

    container.innerHTML = html;

    // 3. Initialize Logic
    window.selectOption = function(type) {
        const dropdown = document.getElementById('plan-selector-box');
        const hiddenInput = document.getElementById('final-selling-plan-input');
        const dropdownSelect = document.getElementById('selling-plan-dropdown');
        const radioOne = container.querySelector('input[value="onetime"]');
        const radioSub = container.querySelector('input[value="subscription"]');

        if (type === 'onetime') {
            dropdown.style.display = 'none';
            hiddenInput.value = ''; // Clear plan ID
            hiddenInput.disabled = true; // Ensure form doesn't send it
            radioOne.checked = true;
        } else {
            dropdown.style.display = 'block';
            hiddenInput.disabled = false;
            hiddenInput.value = dropdownSelect.value; // Set first plan
            radioSub.checked = true;
            
            // Update prices/badges initially
            updateHiddenInput();
        }
    };

    window.updateHiddenInput = function() {
        const dropdownSelect = document.getElementById('selling-plan-dropdown');
        const hiddenInput = document.getElementById('final-selling-plan-input');
        
        // Update ID
        hiddenInput.value = dropdownSelect.value;
        
        // Update Price Display visually
        const selectedOption = dropdownSelect.options[dropdownSelect.selectedIndex];
        const price = parseFloat(selectedOption.getAttribute('data-price'));
        const discount = selectedOption.getAttribute('data-discount');

        document.getElementById('sub-price-display').innerText = formatMoney(price);
        document.getElementById('max-save-display').innerText = discount;
    };

    // Auto-select initial state
    const maxDiscount = Math.max(...plans.map(p => parseFloat(p.discount || 0)));
    document.getElementById('max-save-display').innerText = maxDiscount;

  } catch (err) {
    console.error("Widget Error", err);
    container.style.display = 'none';
  }
})();
</script>