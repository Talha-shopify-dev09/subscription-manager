{% schema %}
{
  "name": "Subscription Options",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Purchase Options" },
    { "type": "color", "id": "accent_color", "label": "Button Color", "default": "#000000" }
  ]
}
{% endschema %}

<div id="subscription-widget-{{ product.id }}" class="sw-wrapper">
  <div style="padding: 15px; text-align: center; color: #6b7280; font-size: 0.9em;">Loading...</div>
</div>

<style>
  .sw-wrapper { margin: 20px 0; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; max-width: 450px; }
  .sw-header { background: #f9fafb; padding: 10px 15px; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #374151; }
  .sw-option-row { display: flex; align-items: flex-start; padding: 15px; cursor: pointer; border-bottom: 1px solid #f3f4f6; }
  .sw-option-row:hover { background-color: #f9fafb; }
  .sw-radio-container { margin-right: 12px; margin-top: 2px; }
  .sw-info { flex: 1; display: flex; flex-direction: column; }
  .sw-top-line { display: flex; justify-content: space-between; align-items: center; width: 100%; }
  .sw-label-text { font-weight: 600; color: #111827; }
  .sw-price-text { color: #374151; }
  .sw-plan-selector { margin-top: 10px; display: none; padding-top: 10px; border-top: 1px solid #f3f4f6; }
  .sw-select { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; }
  .sw-badge { background-color: #d1fae5; color: #059669; font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; font-weight: 600; margin-left: 8px; }
  .sw-footer { padding: 15px; background: #fff; border-top: 1px solid #e5e7eb; }
  .sw-btn { width: 100%; background-color: {{ section.settings.accent_color }}; color: #fff; padding: 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; }
  .sw-btn:hover { opacity: 0.9; }
  .sw-error { color: #ef4444; font-size: 13px; margin-top: 10px; text-align: center; display: none; }
</style>

<script>
(async function() {
  const container = document.getElementById('subscription-widget-{{ product.id }}');
  const productId = '{{ product.id }}';
  const variantId = {{ product.selected_or_first_available_variant.id }};
  const productPrice = {{ product.price }}; 
  const currencySymbol = '{{ cart.currency.symbol }}';

  function formatMoney(cents) { return currencySymbol + (cents / 100).toFixed(2); }

  try {
    const response = await fetch(`/apps/subscription-manager/api/subscription/${productId}`);
    if (!response.ok) { container.style.display = 'none'; return; }
    const data = await response.json();
    if (!data.subscription || !data.subscription.enabled) { container.style.display = 'none'; return; }

    const sub = data.subscription;
    const plans = JSON.parse(sub.plansData || '[]');
    const shopifyIds = JSON.parse(sub.shopifyPlanIds || '{}');

    if (plans.length === 0) { container.style.display = 'none'; return; }

    let html = `
      <div class="sw-header">{{ section.settings.heading }}</div>
      
      <label class="sw-option-row" onclick="selectOption('onetime')">
        <div class="sw-radio-container"><input type="radio" name="purchase_option" value="onetime" checked></div>
        <div class="sw-info">
          <div class="sw-top-line"><span class="sw-label-text">One-time purchase</span><span class="sw-price-text">${formatMoney(productPrice)}</span></div>
        </div>
      </label>

      <label class="sw-option-row" onclick="selectOption('subscription')">
        <div class="sw-radio-container"><input type="radio" name="purchase_option" value="subscription"></div>
        <div class="sw-info">
          <div class="sw-top-line">
            <span class="sw-label-text">Subscribe & Save <span class="sw-badge">Save <span id="max-save-display">10</span>%</span></span>
            <span class="sw-price-text" id="sub-price-display">${formatMoney(productPrice)}</span>
          </div>
          <div class="sw-plan-selector" id="plan-selector-box">
             <select class="sw-select" id="selling-plan-dropdown" onchange="updateUI()">
    `;

    plans.forEach((plan, index) => {
        const key = (index + 1).toString();
        const rawId = shopifyIds[key];
        const cleanId = rawId ? rawId.split('/').pop() : '';
        const discount = parseFloat(plan.discount || 0);
        const price = (productPrice * (1 - discount/100));
        html += `<option value="${cleanId}" data-discount="${discount}" data-price="${price}">Every ${plan.intervalCount} ${plan.interval.toLowerCase()}(s) - Save ${discount}%</option>`;
    });

    html += `</select></div></div></label>
      <div class="sw-footer"><button id="btn-add-to-cart" class="sw-btn" onclick="addToCart()">Add to Cart</button><p id="sw-error-msg" class="sw-error"></p></div>
    `;

    container.innerHTML = html;

    let currentMode = 'onetime'; 
    let currentPlanId = '';

    window.selectOption = function(type) {
        currentMode = type;
        const dropdown = document.getElementById('plan-selector-box');
        const radioOne = container.querySelector('input[value="onetime"]');
        const radioSub = container.querySelector('input[value="subscription"]');

        if (type === 'onetime') {
            dropdown.style.display = 'none';
            radioOne.checked = true;
            currentPlanId = '';
        } else {
            dropdown.style.display = 'block';
            radioSub.checked = true;
            updateUI(); 
        }
    };

    window.updateUI = function() {
        const dropdownSelect = document.getElementById('selling-plan-dropdown');
        currentPlanId = dropdownSelect.value;
        const selectedOption = dropdownSelect.options[dropdownSelect.selectedIndex];
        document.getElementById('sub-price-display').innerText = formatMoney(parseFloat(selectedOption.getAttribute('data-price')));
        document.getElementById('max-save-display').innerText = selectedOption.getAttribute('data-discount');
    };

    window.addToCart = async function() {
        const btn = document.getElementById('btn-add-to-cart');
        const errorMsg = document.getElementById('sw-error-msg');
        errorMsg.style.display = 'none';
        btn.innerText = "Adding...";

        const payload = { id: variantId, quantity: 1 };
        if (currentMode === 'subscription' && currentPlanId) payload.selling_plan = currentPlanId;

        try {
            const response = await fetch('/cart/add.js', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ items: [payload] }) });
            if (response.ok) window.location.href = '/cart';
            else {
                btn.innerText = "Add to Cart";
                errorMsg.innerText = "Error adding to cart.";
                errorMsg.style.display = 'block';
            }
        } catch (err) { console.error(err); btn.innerText = "Add to Cart"; }
    };
    
    // Set max discount badge
    const maxDiscount = Math.max(...plans.map(p => parseFloat(p.discount || 0)));
    document.getElementById('max-save-display').innerText = maxDiscount;

  } catch (err) { console.error(err); container.style.display = 'none'; }
})();
</script>