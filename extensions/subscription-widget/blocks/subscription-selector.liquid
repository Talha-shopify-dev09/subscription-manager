{% schema %}
{
  "name": "Subscription Selector",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe & Save"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Highlight Color",
      "default": "#000000"
    }
  ]
}
{% endschema %}

<style>
  .sw-container {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    margin: 24px 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    font-family: inherit;
  }

  .sw-title {
    margin: 0 0 16px 0;
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    text-align: center;
  }

  /* Grid Layout: 3 columns on desktop, 1 on mobile */
  .sw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }
  @media (max-width: 600px) {
    .sw-grid { grid-template-columns: 1fr; }
  }

  /* Plan Card Styles */
  .sw-label {
    position: relative;
    cursor: pointer;
  }
  
  .sw-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .sw-card {
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px 10px;
    text-align: center;
    transition: all 0.2s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #fff;
  }

  /* Hover State */
  .sw-label:hover .sw-card {
    border-color: #9ca3af;
    transform: translateY(-2px);
  }

  /* Selected State */
  .sw-input:checked + .sw-card {
    border-color: {{ section.settings.accent_color }};
    background-color: #f9fafb;
    box-shadow: 0 0 0 1px {{ section.settings.accent_color }};
  }

  /* Typography */
  .sw-duration {
    font-weight: 700;
    font-size: 16px;
    display: block;
    margin-bottom: 4px;
    color: #374151;
  }
  
  .sw-price {
    font-size: 15px;
    color: #111827;
  }

  .sw-discount {
    font-size: 12px;
    color: #10b981; /* Green for savings */
    font-weight: 600;
    margin-top: 4px;
  }

  /* "Best Value" Badge */
  .sw-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: {{ section.settings.accent_color }};
    color: #fff;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 12px;
    white-space: nowrap;
    z-index: 2;
  }

  /* Button */
  .sw-btn {
    width: 100%;
    background-color: {{ section.settings.accent_color }};
    color: #fff;
    padding: 14px;
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .sw-btn:hover { opacity: 0.9; }
  
  /* Error Message */
  .sw-error {
    color: #ef4444;
    font-size: 13px;
    margin-top: 10px;
    text-align: center;
    display: none;
    background: #fef2f2;
    padding: 8px;
    border-radius: 4px;
  }
</style>

<div id="subscription-widget-{{ product.id }}">
  <div style="padding: 20px; text-align: center; color: #6b7280; background: #f9fafb; border-radius: 8px;">
    <svg style="animation: spin 1s linear infinite; height: 20px; width: 20px; margin-right: 8px;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle style="opacity: 0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path style="opacity: 0.75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
    Loading options...
  </div>
</div>

<style>
@keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<script>
(async function() {
  const container = document.getElementById('subscription-widget-{{ product.id }}');
  const productId = '{{ product.id }}';
  const variantId = {{ product.selected_or_first_available_variant.id }};

  function cleanId(id) {
    if (!id) return null;
    const str = id.toString();
    const parts = str.split('/');
    return parts[parts.length - 1]; 
  }

  try {
    const response = await fetch(`/apps/subscription-manager/api/subscription/${productId}`);
    if (!response.ok) { container.style.display = 'none'; return; }

    const data = await response.json();
    if (!data.subscription || !data.subscription.enabled) {
      container.style.display = 'none';
      return;
    }

    const sub = data.subscription;
    
    let planIds = sub.shopifyPlanIds;
    if (typeof planIds === 'string') {
        try { planIds = JSON.parse(planIds); } catch (e) { planIds = {}; }
    }
    planIds = planIds || {};

    const price = parseFloat('{{ product.price | money_without_currency | remove: "," }}');
    const p1 = (price * (1 - sub.oneMonthDiscount/100)).toFixed(2);
    const p2 = (price * (1 - sub.twoMonthDiscount/100)).toFixed(2);
    const p3 = (price * (1 - sub.threeMonthDiscount/100)).toFixed(2);

    // 2. RENDER THE BEAUTIFUL HTML
    container.innerHTML = `
      <div class="sw-container">
        <h3 class="sw-title">${ '{{ section.settings.heading }}' }</h3>
        
        <div class="sw-grid">
           <label class="sw-label">
             <input type="radio" class="sw-input" name="sub_plan" value="${cleanId(planIds['1']) || ''}" checked>
             <div class="sw-card">
               <span class="sw-duration">1 Month</span>
               <span class="sw-price">${p1}</span>
               <div class="sw-discount">Save ${sub.oneMonthDiscount}%</div>
             </div>
           </label>
           
           <label class="sw-label">
             <input type="radio" class="sw-input" name="sub_plan" value="${cleanId(planIds['2']) || ''}">
             <div class="sw-card">
               <span class="sw-badge">Best Value</span>
               <span class="sw-duration">2 Months</span>
               <span class="sw-price">${p2}</span>
               <div class="sw-discount">Save ${sub.twoMonthDiscount}%</div>
             </div>
           </label>
           
           <label class="sw-label">
             <input type="radio" class="sw-input" name="sub_plan" value="${cleanId(planIds['3']) || ''}">
             <div class="sw-card">
               <span class="sw-duration">3 Months</span>
               <span class="sw-price">${p3}</span>
               <div class="sw-discount">Save ${sub.threeMonthDiscount}%</div>
             </div>
           </label>
        </div>

        <button id="btn-add-sub" class="sw-btn">
            Add Subscription to Cart
        </button>
        <p id="error-msg" class="sw-error"></p>
      </div>
    `;

    // 3. EVENT LISTENER
    document.getElementById('btn-add-sub').addEventListener('click', async function(e) {
        const btn = e.target;
        const errorMsg = document.getElementById('error-msg');
        const selected = container.querySelector('input[name="sub_plan"]:checked');
        
        errorMsg.style.display = 'none';

        if(!selected || !selected.value) {
            errorMsg.innerText = "Error: Plan ID missing. Please edit app settings.";
            errorMsg.style.display = 'block';
            return;
        }

        const planId = parseInt(selected.value);

        if (isNaN(planId)) {
             errorMsg.innerText = "Error: Invalid Plan ID format.";
             errorMsg.style.display = 'block';
             return;
        }

        const originalText = btn.innerText;
        btn.innerText = "Adding...";
        btn.style.opacity = "0.7";
        
        try {
            const cartResponse = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    items: [{
                        id: variantId,
                        quantity: 1,
                        selling_plan: planId 
                    }]
                })
            });

            const cartData = await cartResponse.json();

            if (!cartResponse.ok) {
                btn.innerText = originalText;
                btn.style.opacity = "1";
                errorMsg.innerText = `Error: ${cartData.description || "Issue adding to cart"}`;
                errorMsg.style.display = 'block';
                return;
            }
            window.location.href = '/cart';

        } catch (err) {
            console.error(err);
            btn.innerText = "Error";
            setTimeout(() => { btn.innerText = originalText; btn.style.opacity = "1"; }, 2000);
        }
    });

  } catch (err) {
    console.error("Widget Error", err);
    container.style.display = 'none';
  }
})();
</script>