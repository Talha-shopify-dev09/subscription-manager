{% comment %} 
  Fetch from Shop Metafields 
{% endcomment %}
{% assign all_bundles = shop.metafields.my_app.active_bundles.value %}
{% assign currency_symbol = cart.currency.symbol %}

{% comment %} 
  APP BLOCKS use 'block.id' and 'block.settings' 
{% endcomment %}
{% assign block_scope = 'bundle-block-' | append: block.id %}
{% assign selected_bundle_id = block.settings.bundle_to_show_id | strip %}
{% assign bundle_to_display = null %}

{% comment %} Loop through bundles to find the match by shortId {% endcomment %}
{% if selected_bundle_id != blank and all_bundles != blank %}
  {% for b in all_bundles %}
    {% assign current_short_id = b.shortId | append: '' %}
    {% if current_short_id == selected_bundle_id %}
      {% assign bundle_to_display = b %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<div class="{{ block_scope }} bundle-container" data-bundle-block>
  {% if bundle_to_display != null %}
    
    {% comment %} DEBUG - Remove these lines once working {% endcomment %}
    <div style="background: #fff3cd; padding: 10px; font-size: 11px; border: 1px solid #ffeeba;">
        <strong>DEBUG:</strong> Showing Bundle: {{ bundle_to_display.title }} (ID: {{ bundle_to_display.shortId }})
    </div>

    <section class="bundle-wrapper">
      <div class="bundle-content-column">
        <h2 class="bundle-title">{{ bundle_to_display.title }}</h2>

        <div class="bundle-list">
          {% for product_info in bundle_to_display.products %}
            {% assign prod = all_products[product_info.handle] %}
            {% if prod != empty %}
              <div class="bundle-list-item">
                <div class="item-details">
                  <h3 class="product-title">{{ prod.title }}</h3>
                  <select class="bundle-variant-select" data-bundle-id="{{ bundle_to_display.id }}">
                    {% for variant in prod.variants %}
                      <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} - {{ variant.price | money }}
                      </option>
                    {% endfor %}
                  </select>
                </div>
                <div class="item-pricing">
                  <span class="bundle-price-text">{{ product_info.bundlePrice | times: 100 | money }}</span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <footer class="bundle-footer">
          <div class="total-row">
            <span class="total-label">BUNDLE TOTAL:</span>
            <span class="final-price">{{ currency_symbol }}{{ bundle_to_display.price }}</span>
          </div>
          <button type="button" class="add-bundle-btn" data-add-bundle data-bundle-id="{{ bundle_to_display.id }}">
            Add Bundle to Cart
          </button>
        </footer>
      </div>
    </section>

  {% else %}
    <div class="bundle-placeholder" style="padding: 20px; border: 2px dashed #ccc; text-align: center;">
      <p><strong>Bundle Block</strong></p>
      <p>Please enter a valid Bundle Short ID in the block settings.</p>
      <p>Available IDs: 
        {% for b in all_bundles %}
           <code>{{ b.shortId }}</code>{% unless forloop.last %}, {% endunless %}
        {% endfor %}
      </p>
    </div>
  {% endif %}
</div>

<style>
  .{{ block_scope }}.bundle-container { margin: 20px 0; }
  .{{ block_scope }} .bundle-wrapper { border: 1px solid #ddd; border-radius: 8px; background: #fff; overflow: hidden; }
  .{{ block_scope }} .bundle-content-column { padding: 25px; }
  .{{ block_scope }} .bundle-title { margin-top: 0; font-size: 1.5rem; }
  .{{ block_scope }} .bundle-list-item { display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid #eee; }
  .{{ block_scope }} .bundle-variant-select { margin-top: 8px; padding: 5px; border: 1px solid #ccc; border-radius: 4px; }
  .{{ block_scope }} .add-bundle-btn { width: 100%; padding: 15px; background: #000; color: #fff; border: none; cursor: pointer; font-weight: bold; }
</style>

{% schema %}
{
  "name": "Family Bundle Block",
  "target": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_bundle_image",
      "label": "Custom Bundle Image"
    },
    {
      "type": "text",
      "id": "bundle_to_show_id",
      "label": "Bundle Short ID",
      "info": "Check your app dashboard for the Short ID."
    }
  ]
}
{% endschema %}