{% assign bundles = shop.metafields.my_app.active_bundles.value %}
{% assign currency_symbol = cart.currency.symbol %}

{% if bundles != blank %}
  <div class="bundle-container">
    {% for bundle in bundles %}
      <div class="bundle-wrapper">
        <h2 class="bundle-title">{{ bundle.title }}</h2>
        
        <div class="bundle-grid">
          {% for product_info in bundle.products %}
            {% assign prod = all_products[product_info.handle] %}
            
            {% if prod != empty %}
              {% assign target_price = product_info.bundlePrice | times: 100 %}
              
              <div class="product-card">
                <div class="image-wrapper">
                  <img src="{{ prod.featured_image | img_url: '400x' }}" alt="{{ prod.title }}" loading="lazy">
                </div>
                
                <div class="product-info">
                  <h4 class="product-title">{{ prod.title }}</h4>
                  
                  <div class="price-comparison">
                     <span class="original-price">{{ prod.price | money }}</span>
                     <span class="bundle-price-text">{{ target_price | money }}</span>
                  </div>

                  <div class="variant-selector-wrapper">
                    <label>Select Option:</label>
                    <select 
                        class="bundle-variant-select" 
                        data-bundle-id="{{ bundle.id }}"
                        data-target-price="{{ product_info.bundlePrice }}" 
                    >
                      {% for variant in prod.variants %}
                        <option value="{{ variant.id }}" data-original-price="{{ variant.price | money_without_currency }}">
                          {{ variant.title }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="bundle-footer">
          <div class="total-price-box">
             Bundle Total: <span class="final-price">{{ currency_symbol }}{{ bundle.price }}</span>
          </div>

          <button 
            class="add-bundle-btn"
            onclick="addBundleToCart('{{ bundle.id }}', '{{ currency_symbol }}')">
            Add Bundle to Cart
          </button>
        </div>
      </div>
    {% endfor %}
  </div>

  <style>
    .bundle-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .bundle-wrapper { border: 1px solid #e5e5e5; border-radius: 12px; padding: 30px; margin-bottom: 40px; }
    .bundle-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .product-card { border: 1px solid #eee; border-radius: 8px; overflow: hidden; text-align: center; }
    .image-wrapper { height: 200px; background: #f9f9f9; display: flex; align-items: center; justify-content: center; }
    .image-wrapper img { max-height: 100%; max-width: 100%; object-fit: contain; }
    .product-info { padding: 15px; }
    .price-comparison { margin-bottom: 10px; font-size: 1rem; }
    .original-price { text-decoration: line-through; color: #999; margin-right: 8px; }
    .bundle-price-text { color: #d32f2f; font-weight: bold; }
    .bundle-variant-select { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; background: white; }
    .bundle-footer { text-align: center; border-top: 1px solid #eee; padding-top: 20px; display: flex; flex-direction: column; align-items: center; gap: 15px; }
    .final-price { font-weight: bold; color: #2c6ecb; font-size: 1.5rem; }
    .add-bundle-btn { background: #000; color: #fff; border: none; padding: 12px 40px; font-size: 1rem; border-radius: 50px; cursor: pointer; }
    .add-bundle-btn:hover { background: #333; }
  </style>

  <script>
    function addBundleToCart(bundleId, currencySymbol) {
      const selectors = document.querySelectorAll(`.bundle-variant-select[data-bundle-id="${bundleId}"]`);
      const items = [];
      
      selectors.forEach(select => {
        // 1. Calculate Saving for this specific item
        const targetPrice = parseFloat(select.getAttribute('data-target-price'));
        const originalPrice = parseFloat(select.options[select.selectedIndex].getAttribute('data-original-price').replace(/,/g, ''));
        
        let savedAmount = 0;
        if(originalPrice > targetPrice) {
            savedAmount = (originalPrice - targetPrice).toFixed(2);
        }

        // 2. Prepare Line Item with Properties
        items.push({
          id: select.value,
          quantity: 1,
          properties: { 
             "_bundle_id": bundleId,
             "Saved": `${currencySymbol}${savedAmount}` // <--- THIS SHOWS IN CART
          } 
        });
      });

      console.log("Adding items:", items);

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(response => {
        if(response.ok) {
           window.location.href = '/cart';
        } else {
           alert("Stock Error: Some items unavailable.");
        }
      })
      .catch((error) => {
        console.error('Error:', error);
      });
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Fixed Bundle",
  "target": "section",
  "settings": []
}
{% endschema %}