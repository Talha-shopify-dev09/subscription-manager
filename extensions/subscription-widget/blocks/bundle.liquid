{% comment %}
  Fetch from Shop Metafields
{% endcomment %}
{% assign all_bundles = shop.metafields.my_app.active_bundles.value %}
{% assign currency_symbol = cart.currency.symbol %}

{% assign block_scope = 'bundle-block-' | append: block.id %}
{% assign selected_bundle_id = block.settings.bundle_to_show_id | strip %}
{% assign bundle_to_display = null %}

{% if selected_bundle_id != blank and all_bundles != blank %}
  {% for b in all_bundles %}
    {% assign current_short_id = b.shortId | append: '' %}
    {% if current_short_id == selected_bundle_id %}
      {% assign bundle_to_display = b %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<div 
  class="{{ block_scope }} bundle-container"
  data-bundle-block="{{ block.id }}"
  style="
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    background: {{ block.settings.background_color }};
  "
>

{% if bundle_to_display != null %}

  <section class="bundle-wrapper {% if block.settings.image_position == 'right' %}image-right{% else %}image-left{% endif %}">

    {% if block.settings.show_image and block.settings.custom_bundle_image != blank %}
      <div class="bundle-image-wrapper">
        <img 
          src="{{ block.settings.custom_bundle_image | image_url: width: 1000 }}"
          alt="Bundle Image"
          loading="lazy"
          class="bundle-image"
        >
      </div>
    {% endif %}

    <div class="bundle-content-column">
      <h2 class="bundle-title">{{ bundle_to_display.title }}</h2>

      <div class="bundle-list">
        {% for product_info in bundle_to_display.products %}
          {% assign prod = all_products[product_info.handle] %}
          {% if prod != empty %}
            {% assign bundle_price_cents = product_info.bundlePrice | times: 100 | round %}
            <div class="bundle-list-item" data-product-handle="{{ product_info.handle }}">
              
              <div class="item-details">
                <h3 class="product-title">{{ prod.title }}</h3>

                <select 
                  class="bundle-variant-select"
                  data-product-id="{{ prod.id }}"
                >
                  {% for variant in prod.variants %}
                    <option 
                      value="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      data-price-money="{{ variant.price | money }}"
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }} – {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              </div>

              <div class="item-pricing">
                <span class="original-price">
                  Original: {{ prod.price | money }}
                </span>
                <span class="bundle-price-text" data-bundle-price-cents="{{ bundle_price_cents }}">
                  Bundle: {{ bundle_price_cents | money }}
                </span>
              </div>

            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="bundle-footer">
        <div class="total-row">
          <span>BUNDLE TOTAL</span>
          <span class="final-price">
            {{ currency_symbol }}
            <span class="bundle-final-price"></span>
          </span>
        </div>

        <button type="button" class="add-bundle-btn">
          Add Bundle to Cart
        </button>

        <p class="bundle-error"></p>
      </div>
    </div>
  </section>

{% else %}
  <div class="bundle-placeholder">
    <strong>Bundle Block</strong><br>
    Please enter a valid Bundle Short ID.
  </div>
{% endif %}
</div>

<style>
.{{ block_scope }} .bundle-wrapper {
  border-radius: 14px;
  background: {{ block.settings.card_background }};
  box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  overflow: hidden;
  display: flex;
  gap: 05px;
}

.{{ block_scope }} .bundle-wrapper.image-right {
  flex-direction: row-reverse;
}

.{{ block_scope }} .bundle-image-wrapper {
  text-align: center;
  flex: 0 0 {{ block.settings.image_width }}%;
  max-width: {{ block.settings.image_width }}%;
}

.{{ block_scope }} .bundle-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.{{ block_scope }} .bundle-content-column {
  padding: 30px;
  flex: 1 1 auto;
}

.{{ block_scope }} .bundle-title {
  font-size: 1.6rem;
  margin-bottom: 25px;
  color: {{ block.settings.heading_color }};
}

.{{ block_scope }} .bundle-list-item {
  display: flex;
  justify-content: space-between;
  padding: 18px 0;
  border-bottom: 1px solid {{ block.settings.border_color }};
}

.{{ block_scope }} .product-title {
  margin: 0;
  color: {{ block.settings.text_color }};
}

.{{ block_scope }} .bundle-variant-select {
  margin-top: 10px;
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid {{ block.settings.border_color }};
  cursor: pointer;
  transition: 0.3s ease;
}

.{{ block_scope }} .bundle-variant-select:hover {
  border-color: {{ block.settings.button_color }};
}

.{{ block_scope }} .item-pricing {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.{{ block_scope }} .original-price {
  color: #8c9196;
  text-decoration: line-through;
  font-size: 0.95rem;
}

.{{ block_scope }} .bundle-price-text {
  color: {{ block.settings.text_color }};
  font-weight: 600;
}

.{{ block_scope }} .total-row {
  display: flex;
  justify-content: space-between;
  margin-top: 25px;
  font-weight: 600;
  color: {{ block.settings.text_color }};
}

.{{ block_scope }} .add-bundle-btn {
  width: 100%;
  margin-top: 20px;
  padding: 16px;
  background: {{ block.settings.button_color }};
  color: {{ block.settings.button_text_color }};
  border: none;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s ease;
}

.{{ block_scope }} .add-bundle-btn:hover {
  opacity: 0.85;
}

.{{ block_scope }} .bundle-error {
  color: red;
  display: none;
  margin-top: 10px;
}

.{{ block_scope }} .bundle-placeholder {
  padding: 20px;
  border: 2px dashed #ccc;
  text-align: center;
}

/* Custom CSS From Theme Editor */
{{ block.settings.custom_css }}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.querySelector('[data-bundle-block="{{ block.id }}"]');
  if (!container) return;

  const selects = container.querySelectorAll('.bundle-variant-select');
  const totalEl = container.querySelector('.bundle-final-price');
  const button = container.querySelector('.add-bundle-btn');
  const errorEl = container.querySelector('.bundle-error');
  const cartAction = '{{ block.settings.cart_action }}'; 

  function updateOriginalPrice(select) {
    const option = select.options[select.selectedIndex];
    const item = select.closest('.bundle-list-item');
    const originalEl = item?.querySelector('.original-price');
    if (originalEl && option?.dataset?.priceMoney) {
      originalEl.innerText = `Original: ${option.dataset.priceMoney}`;
    }
  }

  function updateTotal() {
    let total = 0;
    const priceEls = container.querySelectorAll('.bundle-price-text');
    priceEls.forEach(priceEl => {
      const cents = priceEl.dataset.bundlePriceCents;
      if (cents) total += parseInt(cents, 10);
    });
    totalEl.innerText = (total / 100).toFixed(2);
  }

  selects.forEach(select => {
    select.addEventListener('change', () => {
      updateOriginalPrice(select);
      updateTotal();
    });
    updateOriginalPrice(select);
  });
  updateTotal();

  button.addEventListener('click', async function() {
    errorEl.style.display = "none";
    button.disabled = true;
    const originalText = button.innerText;
    button.innerText = "Adding...";

    const items = [];
    selects.forEach(select => {
      if (!select.value) return;
      items.push({ id: parseInt(select.value), quantity: 1 });
    });

    try {
      const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          items: items,
          sections: "cart-drawer,cart-notification,cart-icon-bubble" 
        })
      });

      const responseData = await response.json();
      if (!response.ok) throw new Error(responseData.description || "Failed to add bundle");

      if (cartAction === 'drawer') {
        const cartDrawer = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        
        if (cartDrawer) {
          if (cartDrawer.renderContents) {
             cartDrawer.renderContents(responseData);
          } else {
             document.dispatchEvent(new CustomEvent('cart:updated', {
               detail: { cart: responseData }
             }));
             document.querySelector('#cart-icon-bubble')?.click();
          }
        } else {
          const cartIcon = document.querySelector('#cart-icon-bubble, .header__icon--cart, .cart-icon');
          if (cartIcon) cartIcon.click();
          else window.location.href = window.Shopify.routes.root + "cart";
        }
      } else {
        window.location.href = window.Shopify.routes.root + "cart";
      }

    } catch (err) {
      errorEl.innerText = err.message;
      errorEl.style.display = "block";
    } finally {
      button.disabled = false;
      button.innerText = originalText;
    }
  });
});
</script>

{% schema %}
{
  "name": "Socoba Bundle Block",
  "target": "section",
  "settings": [
    { "type": "text", "id": "bundle_to_show_id", "label": "Bundle Short ID" },

    { "type": "checkbox", "id": "show_image", "label": "Show Bundle Image", "default": true },
    { "type": "image_picker", "id": "custom_bundle_image", "label": "Custom Bundle Image" },

    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "range",
      "id": "image_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40,
      "label": "Image Width (Percent)"
    },

    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "default": 30, "label": "Padding Top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 5, "default": 30, "label": "Padding Bottom" },
    { "type": "range", "id": "padding_left", "min": 0, "max": 100, "step": 5, "default": 0, "label": "Padding Left" },
    { "type": "range", "id": "padding_right", "min": 0, "max": 100, "step": 5, "default": 0, "label": "Padding Right" },

    { "type": "color", "id": "background_color", "label": "Section Background", "default": "#f9f9f9" },
    { "type": "color", "id": "card_background", "label": "Card Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#333333" },
    { "type": "color", "id": "button_color", "label": "Button Background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border Color", "default": "#e5e5e5" },

    {
      "type": "select",
      "id": "cart_action",
      "label": "After Add to Cart",
      "default": "drawer",
      "options": [
        { "value": "drawer", "label": "Open Cart Drawer" },
        { "value": "page", "label": "Go to Cart Page" }
      ]
    },

    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ]
}
{% endschema %}
