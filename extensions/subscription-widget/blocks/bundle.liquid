{% comment %}
  Fetch from Shop Metafields
{% endcomment %}
{% assign all_bundles = shop.metafields.my_app.active_bundles.value %}
{% assign currency_symbol = cart.currency.symbol %}

{% assign block_scope = 'bundle-block-' | append: block.id %}
{% assign selected_bundle_id = block.settings.bundle_to_show_id | strip %}
{% assign bundle_to_display = null %}

{% if selected_bundle_id != blank and all_bundles != blank %}
  {% for b in all_bundles %}
    {% assign current_short_id = b.shortId | append: '' %}
    {% if current_short_id == selected_bundle_id %}
      {% assign bundle_to_display = b %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<div
  class="{{ block_scope }} bundle-container"
  data-bundle-block="{{ block.id }}"
  style="
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    background: {{ block.settings.background_color }};
  "
>
  {% if bundle_to_display != null %}
    <section class="bundle-wrapper {% if block.settings.image_position == 'right' %}image-right{% else %}image-left{% endif %}">
      {% comment %} Image Column {% endcomment %}
      {% if block.settings.show_image and block.settings.custom_bundle_image != blank %}
        <div class="bundle-image-column">
          <img
            src="{{ block.settings.custom_bundle_image | image_url: width: 1200 }}"
            alt="{{ bundle_to_display.title }}"
            loading="lazy"
            class="bundle-image"
          >
        </div>
      {% endif %}

      {% comment %} Content Column {% endcomment %}
      <div class="bundle-content-column">
        {% comment %} Bundle Title {% endcomment %}
        <h2 class="bundle-title">{{ bundle_to_display.title }}</h2>

        {% comment %} Product List {% endcomment %}
        <div class="bundle-products-list">
          {% for product_info in bundle_to_display.products %}
            {% assign prod = all_products[product_info.handle] %}
            {% if prod != empty %}
              {% assign first_variant = prod.selected_or_first_available_variant %}
              {% assign bundle_price_cents = product_info.bundlePrice | times: 100 | round %}

              <div class="bundle-product-item" data-product-handle="{{ product_info.handle }}">
                <div class="product-info">
                  <h3 class="product-name">{{ prod.title }}</h3>

                  {% comment %} Variant Selector {% endcomment %}
                  {% assign first_variant = prod.selected_or_first_available_variant %}

                  {% if prod.variants.size > 1 %}
                    <select
                      class="variant-selector"
                      data-product-id="{{ prod.id }}"
                    >
                      {% for variant in prod.variants %}
                        <option
                          value="{{ variant.id }}"
                          data-price="{{ variant.price }}"
                          data-price-money="{{ variant.price | money }}"
                          {% unless variant.available %}
                            disabled
                          {% endunless %}
                        >
                          {{ variant.title -}}
                          {%- unless variant.available %} (Sold Out){% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  {% else %}
                    <input
                      type="hidden"
                      class="bundle-variant-id"
                      value="{{ first_variant.id }}"
                      data-price="{{ first_variant.price }}"
                      data-price-money="{{ first_variant.price | money }}"
                      data-product-id="{{ prod.id }}"
                    >
                  {% endif %}
                </div>

                <div class="product-price">
                  {% if block.settings.show_original_price %}
                    <span class="price-original" data-original-money="{{ first_variant.price | money }}">
                      {{ first_variant.price | money }}
                    </span>
                  {% endif %}

                  <span class="price-bundle" data-bundle-price-cents="{{ bundle_price_cents }}">
                    {{ bundle_price_cents | money }}
                  </span>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% comment %} Bundle Footer {% endcomment %}
        <div class="bundle-footer">
          <div class="bundle-total-row">
            <span class="total-label">TOTAL</span>
            <span class="total-price">
              {{ currency_symbol -}}
              <span class="total-amount"></span>
            </span>
          </div>

          <button type="button" class="buy-now-button">
            {{ block.settings.button_text }}
          </button>

          <p class="error-message"></p>
        </div>
      </div>
    </section>

  {% else %}
    <div class="bundle-placeholder">
      <strong>Bundle Block</strong><br>
      Please enter a valid Bundle Short ID in the theme editor.
    </div>
  {% endif %}
</div>

<style>
    /* Container */
    .{{ block_scope }}.bundle-container {
      max-width: {{ block.settings.max_width }}px;
      margin: 0 auto;
    }

    /* Two Column Layout */
    .{{ block_scope }} .bundle-wrapper {
      display: grid;
      grid-template-columns: {% if block.settings.show_image %}{{ block.settings.image_width }}% 1fr{% else %}1fr{% endif %};
      gap: {{ block.settings.column_gap }}px;
      background: {{ block.settings.card_background }};
      border-radius: {{ block.settings.border_radius }}px;
      overflow: hidden;
      box-shadow: {{ block.settings.box_shadow }};
    }

    .{{ block_scope }} .bundle-wrapper.image-right {
      grid-template-columns: {% if block.settings.show_image %}1fr {{ block.settings.image_width }}%{% else %}1fr{% endif %};
    }

    /* Image Column */
    .{{ block_scope }} .bundle-image-column {
      position: relative;
      min-height: 400px;
    }

    .{{ block_scope }} .bundle-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Content Column */
    .{{ block_scope }} .bundle-content-column {
      padding: {{ block.settings.content_padding }}px;
      display: flex;
      flex-direction: column;
    }

    /* Bundle Title */
    .{{ block_scope }} .bundle-title {
      font-size: {{ block.settings.title_font_size }}px;
      font-weight: {{ block.settings.title_font_weight }};
      color: {{ block.settings.heading_color }};
      margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
      line-height: 1.3;
    }

    /* Products List */
    .{{ block_scope }} .bundle-products-list {
      flex: 1;
      margin-bottom: {{ block.settings.products_margin_bottom }}px;
    }

    .{{ block_scope }} .bundle-product-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: {{ block.settings.product_item_padding }}px 0;
      border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.border_color }};
      gap: 20px;
    }

    .{{ block_scope }} .bundle-product-item:last-child {
      border-bottom: none;
    }

    .{{ block_scope }} .product-info {
      flex: 1;
    }

    .{{ block_scope }} .product-name {
      font-size: {{ block.settings.product_name_font_size }}px;
      font-weight: {{ block.settings.product_name_font_weight }};
      color: {{ block.settings.text_color }};
      margin: 0 0 8px 0;
    }

    .{{ block_scope }} .variant-selector {
      padding: {{ block.settings.selector_padding }}px;
      border: {{ block.settings.selector_border_width }}px solid {{ block.settings.border_color }};
      border-radius: {{ block.settings.selector_border_radius }}px;
      background: {{ block.settings.selector_background }};
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.selector_font_size }}px;
      cursor: pointer;
      transition: all 0.2s ease;
      width: 100%;
      max-width: 300px;
    }

    .{{ block_scope }} .variant-selector:hover {
      border-color: {{ block.settings.button_color }};
    }

    .{{ block_scope }} .variant-selector:focus {
      outline: none;
      border-color: {{ block.settings.button_color }};
      box-shadow: 0 0 0 2px {{ block.settings.button_color }}33;
    }

    .{{ block_scope }} .product-price {
      flex-shrink: 0;
      text-align: right;
    }

    .{{ block_scope }} .price-value {
      font-size: {{ block.settings.price_font_size }}px;
      font-weight: {{ block.settings.price_font_weight }};
      color: {{ block.settings.text_color }};
    }

    /* Bundle Footer */
    .{{ block_scope }} .bundle-footer {
      border-top: {{ block.settings.footer_border_thickness }}px solid {{ block.settings.border_color }};
      padding-top: {{ block.settings.footer_padding_top }}px;
    }

    .{{ block_scope }} .bundle-total-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: {{ block.settings.total_margin_bottom }}px;
    }

    .{{ block_scope }} .total-label {
      font-size: {{ block.settings.total_label_font_size }}px;
      font-weight: {{ block.settings.total_font_weight }};
      color: {{ block.settings.text_color }};
      letter-spacing: 1px;
    }

    .{{ block_scope }} .total-price {
      font-size: {{ block.settings.total_price_font_size }}px;
      font-weight: {{ block.settings.total_font_weight }};
      color: {{ block.settings.heading_color }};
    }

    /* Buy Now Button */
    .{{ block_scope }} .buy-now-button {
      width: 100%;
      padding: {{ block.settings.button_padding }}px;
      background: {{ block.settings.button_color }};
      color: {{ block.settings.button_text_color }};
      font-size: {{ block.settings.button_font_size }}px;
      font-weight: {{ block.settings.button_font_weight }};
      border: none;
      border-radius: {{ block.settings.button_border_radius }}px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: {{ block.settings.button_text_transform }};
      letter-spacing: 0.5px;
    }

    .{{ block_scope }} .buy-now-button:hover {
      background: {{ block.settings.button_hover_color }};
      transform: translateY(-1px);
      box-shadow: 0 4px 12px {{ block.settings.button_color }}40;
    }

    .{{ block_scope }} .buy-now-button:active {
      transform: translateY(0);
    }

    .{{ block_scope }} .buy-now-button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    /* Error Message */
    .{{ block_scope }} .error-message {
      color: {{ block.settings.error_color }};
      font-size: 14px;
      margin: 12px 0 0 0;
      display: none;
      text-align: center;
    }

    /* Placeholder */
    .{{ block_scope }} .bundle-placeholder {
      padding: 60px 20px;
      border: 2px dashed {{ block.settings.border_color }};
      border-radius: {{ block.settings.border_radius }}px;
      text-align: center;
      color: {{ block.settings.text_color }};
    }

    /* Responsive Design */
    @media (max-width: {{ block.settings.mobile_breakpoint }}px) {
      .{{ block_scope }} .bundle-wrapper {
        grid-template-columns: 1fr !important;
      }

      .{{ block_scope }} .bundle-image-column {
        min-height: 300px;
      }

      .{{ block_scope }} .bundle-content-column {
        padding: {{ block.settings.mobile_content_padding }}px;
      }

      .{{ block_scope }} .bundle-title {
        font-size: {{ block.settings.mobile_title_font_size }}px;
      }

      .{{ block_scope }} .variant-selector {
        max-width: 100%;
      }
    }
    .{{ block_scope }} .product-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .{{ block_scope }} .price-original {
    color: #8c9196;
    text-decoration: line-through;
    font-size: 0.95em;
  }

  .{{ block_scope }} .price-bundle {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: {{ block.settings.price_font_weight }};
    color: {{ block.settings.text_color }};
  }

    /* Custom CSS From Theme Editor */
    {{ block.settings.custom_css }}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('[data-bundle-block="{{ block.id }}"]');
    if (!container) return;

    const selects = Array.from(container.querySelectorAll('.variant-selector'));
    const singles = Array.from(container.querySelectorAll('.bundle-variant-id'));

    const totalAmountEl = container.querySelector('.total-amount');
    const button = container.querySelector('.buy-now-button');
    const errorEl = container.querySelector('.error-message');
    const cartAction = '{{ block.settings.cart_action }}';

    function moneyFromCents(cents) {
      return (cents / 100).toFixed(2);
    }

    function getPriceFromControl(el) {
      if (!el) return 0;

      if (el.matches('select')) {
        const opt = el.options[el.selectedIndex];
        const p = Number(opt && opt.dataset && opt.dataset.price);
        return Number.isFinite(p) ? p : 0;
      }

      const p = Number(el.dataset.price);
      return Number.isFinite(p) ? p : 0;
    }

    function updateProductPrice(select) {
      const row = select.closest('.bundle-product-item');
      if (!row) return;

      const originalEl = row.querySelector('.price-original');
      if (!originalEl) return; // original price is disabled in settings

      const opt = select.options[select.selectedIndex];
      const money = opt?.dataset?.priceMoney;
      if (money) originalEl.textContent = money;
    }

    function updateTotal() {
      let total = 0;
      const bundlePrices = container.querySelectorAll('.price-bundle[data-bundle-price-cents]');
      bundlePrices.forEach((el) => {
        const cents = parseInt(el.dataset.bundlePriceCents, 10);
        if (Number.isFinite(cents)) total += cents;
      });
      totalAmountEl.textContent = (total / 100).toFixed(2);
    }

    selects.forEach((select) => {
      select.addEventListener('change', function () {
        updateProductPrice(this);
        updateTotal();
      });
    });

    updateTotal();

    async function fetchSectionsForHorizon() {
      const cartItemsComponents = Array.from(document.querySelectorAll('cart-items-component[data-section-id]'));
      const sectionIds = cartItemsComponents.map((el) => el.getAttribute('data-section-id')).filter(Boolean);

      if (!sectionIds.length) return null;

      const url = window.Shopify.routes.root + '?sections=' + encodeURIComponent(sectionIds.join(','));
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) return null;
      return await res.json();
    }

    function dispatchHorizonCartUpdate({ itemCount, sections }) {
      document.dispatchEvent(
        new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            sourceId: 'bundle-block-{{ block.id }}',
            data: {
              source: 'product-form-component',
              itemCount: itemCount,
              sections: sections || null,
            },
          },
        })
      );
    }

    function openHorizonDrawer() {
      const drawer = document.querySelector('cart-drawer-component');
      if (drawer && typeof drawer.open === 'function') {
        drawer.open();
        return;
      }

      const trigger = document.querySelector('[data-testid="cart-drawer-trigger"]');
      if (trigger) trigger.click();
    }

    button.addEventListener('click', async function () {
      errorEl.style.display = 'none';
      button.disabled = true;

      const originalText = button.textContent;
      button.textContent = '{{ block.settings.button_loading_text }}';

      const items = [];

      selects.forEach((select) => {
        const variantId = select.value;
        if (variantId) items.push({ id: Number(variantId), quantity: 1 });
      });

      singles.forEach((input) => {
        const variantId = input.value;
        if (variantId) items.push({ id: Number(variantId), quantity: 1 });
      });

      if (!items.length) {
        errorEl.textContent = 'Please select variants for all products';
        errorEl.style.display = 'block';
        button.disabled = false;
        button.textContent = originalText;
        return;
      }

      try {
        const addRes = await fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items }),
        });

        const addData = await addRes.json();
        if (!addRes.ok) throw new Error(addData.description || addData.message || 'Failed to add bundle to cart');

        const sections = await fetchSectionsForHorizon();

        const itemCountAdded = items.reduce((sum, it) => sum + (Number(it.quantity) || 0), 0);
        dispatchHorizonCartUpdate({ itemCount: itemCountAdded, sections });

        if (cartAction === 'drawer') {
          openHorizonDrawer();
        } else {
          window.location.href = window.Shopify.routes.root + 'cart';
        }
      } catch (err) {
        errorEl.textContent = err.message;
        errorEl.style.display = 'block';
      } finally {
        button.disabled = false;
        button.textContent = originalText;
      }
    });
  });
</script>

{% schema %}
{
  "name": "Socoba Bundle Block",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "bundle_to_show_id",
      "label": "Bundle Short ID",
      "info": "Enter the short ID of the bundle to display"
