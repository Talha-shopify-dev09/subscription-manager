{% assign bundles = shop.metafields.my_app.active_bundles.value %}
{% assign currency_symbol = cart.currency.symbol %}
{% assign section_scope = 'bundle-' | append: section.id %}

{% if bundles != blank %}
  <div class="{{ section_scope }} bundle-container" data-bundle-section>
    {% for bundle in bundles %}
      <section class="bundle-wrapper" aria-labelledby="bundle-title-{{ section.id }}-{{ bundle.id }}">
        <header class="bundle-header">
          <h2 id="bundle-title-{{ section.id }}-{{ bundle.id }}" class="bundle-title">
            {{ bundle.title }}
          </h2>
        </header>

        <div class="bundle-grid" role="list">
          {% for product_info in bundle.products %}
            {% assign prod = all_products[product_info.handle] %}
            {% if prod != empty %}
              {% assign target_price_cents = product_info.bundlePrice | times: 100 | round %}

              <article class="product-card" role="listitem">
                <div class="image-wrapper">
                  {% if prod.featured_image %}
                    <img
                      src="{{ prod.featured_image | image_url: width: 600 }}"
                      alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="image-fallback" aria-hidden="true"></div>
                  {% endif %}
                </div>

                <div class="product-info">
                  <h3 class="product-title">{{ prod.title }}</h3>

                  <div class="price-comparison" aria-label="Price comparison">
                    <span class="original-price">{{ prod.price | money }}</span>
                    <span class="bundle-price-text">{{ target_price_cents | money }}</span>
                  </div>

                  <div class="variant-selector-wrapper">
                    {% assign select_id = 'bundle-variant-' | append: section.id | append: '-' | append: bundle.id | append: '-' | append: prod.id %}
                    <label for="{{ select_id }}">Select option</label>

                    <select
                      id="{{ select_id }}"
                      class="bundle-variant-select"
                      data-bundle-id="{{ bundle.id }}"
                      data-product-handle="{{ product_info.handle }}"
                      data-target-price-cents="{{ target_price_cents }}"
                    >
                      {% for variant in prod.variants %}
                        <option
                          value="{{ variant.id }}"
                          data-variant-price-cents="{{ variant.price }}"
                          {% if variant.available == false %}disabled{% endif %}
                        >
                          {{ variant.title }}{% unless variant.available %} (Sold out){% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>

        <footer class="bundle-footer">
          <div class="total-price-box" aria-live="polite">
            <div class="bundle-total-row">
              <span>Bundle total</span>
              <span class="final-price" data-bundle-total>{{ currency_symbol }}{{ bundle.price }}</span>
            </div>
            <div class="bundle-savings-row" data-bundle-savings-row hidden>
              <span>You save</span>
              <span class="bundle-savings" data-bundle-savings></span>
            </div>
          </div>

          <button
            type="button"
            class="add-bundle-btn"
            data-add-bundle
            data-bundle-id="{{ bundle.id }}"
          >
            Add bundle to cart
          </button>

          <p class="bundle-note" aria-hidden="true">
            Bundle items are added individually.
          </p>
        </footer>
      </section>
    {% endfor %}
  </div>

  <style>
    .{{ section_scope }}.bundle-container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }

    .{{ section_scope }} .bundle-wrapper {
      border: 1px solid #e9e9e9;
      border-radius: 14px;
      padding: 28px;
      margin-bottom: 34px;
      background: #fff;
    }

    .{{ section_scope }} .bundle-title { margin: 0 0 18px; font-size: 1.35rem; letter-spacing: -0.01em; }

    .{{ section_scope }} .bundle-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-bottom: 26px;
    }

    .{{ section_scope }} .product-card {
      border: 1px solid #efefef;
      border-radius: 12px;
      overflow: hidden;
      background: #fff;
      display: flex;
      flex-direction: column;
    }

    .{{ section_scope }} .image-wrapper {
      background: #f7f7f7;
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .{{ section_scope }} .image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .{{ section_scope }} .image-fallback {
      width: 60%;
      height: 60%;
      border-radius: 12px;
      background: #ededed;
    }

    .{{ section_scope }} .product-info { padding: 14px 14px 16px; }

    .{{ section_scope }} .product-title { margin: 0 0 8px; font-size: 1rem; line-height: 1.25; }

    .{{ section_scope }} .price-comparison { margin-bottom: 12px; font-size: 0.98rem; display: flex; gap: 10px; align-items: baseline; }
    .{{ section_scope }} .original-price { text-decoration: line-through; color: #8b8b8b; }
    .{{ section_scope }} .bundle-price-text { color: #c62828; font-weight: 700; }

    .{{ section_scope }} .variant-selector-wrapper label {
      display: block;
      font-size: 0.85rem;
      margin-bottom: 6px;
      color: #444;
    }

    .{{ section_scope }} .bundle-variant-select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #dedede;
      border-radius: 10px;
      background: #fff;
      outline: none;
    }

    .{{ section_scope }} .bundle-variant-select:focus {
      border-color: #111;
      box-shadow: 0 0 0 2px rgba(0,0,0,0.12);
    }

    .{{ section_scope }} .bundle-footer {
      border-top: 1px solid #eee;
      padding-top: 18px;
      display: grid;
      gap: 12px;
      justify-items: center;
      text-align: center;
    }

    .{{ section_scope }} .total-price-box { width: 100%; max-width: 520px; }
    .{{ section_scope }} .bundle-total-row,
    .{{ section_scope }} .bundle-savings-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid #efefef;
      border-radius: 12px;
      background: #fafafa;
    }

    .{{ section_scope }} .bundle-savings-row { background: #f5f7ff; border-color: #e7eaff; }

    .{{ section_scope }} .final-price { font-weight: 800; color: #1f4fbf; font-size: 1.2rem; }

    .{{ section_scope }} .bundle-savings { font-weight: 700; color: #0b7a2a; }

    .{{ section_scope }} .add-bundle-btn {
      background: #000;
      color: #fff;
      border: none;
      padding: 12px 34px;
      font-size: 1rem;
      border-radius: 999px;
      cursor: pointer;
      transition: opacity .15s ease, transform .15s ease;
      width: fit-content;
    }

    .{{ section_scope }} .add-bundle-btn:hover { opacity: 0.92; transform: translateY(-1px); }
    .{{ section_scope }} .add-bundle-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .{{ section_scope }} .bundle-note { margin: 0; font-size: 0.85rem; color: #777; }
  </style>

  <script>
    (function () {
      const root = document.querySelector('.{{ section_scope }}[data-bundle-section]');
      if (!root) return;

      function formatMoneyFromCents(cents) {
        // Basic formatter using store currency symbol in Liquid, avoids locale issues
        const symbol = {{ currency_symbol | json }};
        return symbol + (cents / 100).toFixed(2);
      }

      function getBundleSelectors(bundleId) {
        return root.querySelectorAll(`.bundle-variant-select[data-bundle-id="${bundleId}"]`);
      }

      function computeSavingsCents(bundleId) {
        const selects = getBundleSelectors(bundleId);
        let savings = 0;

        selects.forEach(sel => {
          const target = parseInt(sel.getAttribute('data-target-price-cents') || '0', 10);
          const opt = sel.options[sel.selectedIndex];
          const original = parseInt(opt.getAttribute('data-variant-price-cents') || '0', 10);

          if (original > target) savings += (original - target);
        });

        return savings;
      }

      function updateBundleSavingsUI(bundleId) {
        const wrapper = root.querySelector(`[data-add-bundle][data-bundle-id="${bundleId}"]`)?.closest('.bundle-wrapper');
        if (!wrapper) return;

        const row = wrapper.querySelector('[data-bundle-savings-row]');
        const el = wrapper.querySelector('[data-bundle-savings]');
        if (!row || !el) return;

        const savingsCents = computeSavingsCents(bundleId);

        if (savingsCents > 0) {
          el.textContent = formatMoneyFromCents(savingsCents);
          row.hidden = false;
        } else {
          row.hidden = true;
        }
      }

      // Listen for variant changes to refresh savings
      root.addEventListener('change', (e) => {
        const sel = e.target.closest('.bundle-variant-select');
        if (!sel) return;
        const bundleId = sel.getAttribute('data-bundle-id');
        if (bundleId) updateBundleSavingsUI(bundleId);
      });

      // Initialize savings for each bundle on load
      root.querySelectorAll('[data-add-bundle]').forEach(btn => {
        updateBundleSavingsUI(btn.getAttribute('data-bundle-id'));
      });

      async function addBundleToCart(bundleId, buttonEl) {
        const selectors = getBundleSelectors(bundleId);
        const items = [];

        selectors.forEach(select => {
          const targetCents = parseInt(select.getAttribute('data-target-price-cents') || '0', 10);
          const opt = select.options[select.selectedIndex];
          const originalCents = parseInt(opt.getAttribute('data-variant-price-cents') || '0', 10);

          const savedCents = Math.max(0, originalCents - targetCents);

          items.push({
            id: Number(select.value),
            quantity: 1,
            properties: {
              "_bundle_id": bundleId,
              "Saved": formatMoneyFromCents(savedCents)
            }
          });
        });

        buttonEl.disabled = true;
        const oldText = buttonEl.textContent;
        buttonEl.textContent = "Adding…";

        try {
          const res = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (!res.ok) {
            buttonEl.disabled = false;
            buttonEl.textContent = oldText;
            alert("Some items are unavailable. Please pick different variants.");
            return;
          }

          window.location.href = '/cart';
        } catch (err) {
          console.error(err);
          buttonEl.disabled = false;
          buttonEl.textContent = oldText;
          alert("Something went wrong. Please try again.");
        }
      }

      root.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-bundle]');
        if (!btn) return;

        const bundleId = btn.getAttribute('data-bundle-id');
        if (!bundleId) return;

        addBundleToCart(bundleId, btn);
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Fixed Bundle",
  "target": "section",
  "settings": []
}
{% endschema %}
