    {
      "type": "checkbox",
      "id": "show_original_price",
      "label": "Show original price (strikethrough)",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200,
      "unit": "px",
      "label": "Maximum Width"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px",
      "label": "Gap Between Columns"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 0,
      "unit": "px",
