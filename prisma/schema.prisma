// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
// Using Enums prevents typos in your database and code
enum SubscriptionType {
  PRODUCT
  COLLECTION
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

enum BasicFeatureMode {
  BUNDLE
  SUBSCRIPTION
}

// --- SESSION MODEL ---
model Session {
  id              String    @id
  shop            String
  state           String
  isOnline        Boolean   @default(false)
  scope           String?
  expires         DateTime?
  accessToken     String
  userId          BigInt?
  firstName       String?
  lastName        String?
  email           String?
  accountOwner    Boolean   @default(false)
  locale          String?
  collaborator    Boolean?  @default(false)
  emailVerified   Boolean?  @default(false)
  refreshToken    String?
  refreshTokenExpires DateTime?
}

// --- SUBSCRIPTION PLAN MODEL ---
model Subscription {
  id             String           @id @default(uuid())
  shop           String
  type           SubscriptionType @default(PRODUCT)
  targetId       String           // Shopify GID for the product or collection
  targetTitle    String
  originalPrice  String
  
  // Using Json type removes the need for JSON.parse/stringify in your code
  plansData      Json             
  shopifyPlanIds Json?            

  shopifyGroupId String?          // gid://shopify/SellingPlanGroup/123
  enabled        Boolean          @default(true)
  
  contracts      Contract[]       // Relation to actual customer contracts
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([shop])
}

// --- BUNDLE MODEL ---
model Bundle {
  id           String   @id @default(uuid())
    shortId      String?
    shop         String
    title        String
    price        String?
    discount     String?
    discountCode String?
    discountId   String?  // gid://shopify/DiscountAutomaticNode/123
  
    productIds   Json     // Stores GIDs as a JSON array
  
    contracts    Contract[]
  
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
  
    @@index([shop])
    @@unique([shop, shortId])
  }
// --- CONTRACT MODEL ---
model Contract {
  id              String         @id // gid://shopify/SubscriptionContract/123
  shop            String
  customerId      String?
  customerName    String?
  customerEmail   String?
  status          ContractStatus @default(ACTIVE)
  nextBillingDate DateTime?
  recurringPrice  Decimal?       // Price for each recurring payment
  currencyCode    String         @default("USD")
  
  // Explicit Relations
  planId          String?        
  subscription    Subscription?  @relation(fields: [planId], references: [id])
  
  bundleId        String?
  bundle          Bundle?        @relation(fields: [bundleId], references: [id])
  
  transactions    Transaction[]  // Relation to successful transactions
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([shop])
  @@index([status])
}

// --- TRANSACTION MODEL ---
model Transaction {
  id           String   @id @default(uuid())
  shop         String
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id])
  amount       Decimal
  currencyCode String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([shop])
  @@index([contractId])
}

// --- BUNDLE SALE MODEL ---
model BundleSale {
  id           String    @id @default(uuid())
  shop         String
  orderId      String    // Shopify Order GID
  bundleId     String    // Our app's Bundle ID
  bundleTitle  String
  totalAmount  Decimal
  currencyCode String
  customerId   String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop])
  @@index([orderId])
  @@index([bundleId])
}

// --- SHOP SETTINGS MODEL ---
model ShopSetting {
  id               String           @id @default(uuid())
  shop             String           @unique
  planName         String?
  basicFeatureMode BasicFeatureMode?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
