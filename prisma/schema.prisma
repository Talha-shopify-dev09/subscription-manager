// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
// Using Enums prevents typos in your database and code
enum SubscriptionType {
  PRODUCT
  COLLECTION
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

// --- SESSION MODEL ---
model Session {
  id              String    @id
  shop            String
  state           String
  isOnline        Boolean   @default(false)
  scope           String?
  expires         DateTime?
  accessToken     String
  userId          BigInt?
  firstName       String?
  lastName        String?
  email           String?
  accountOwner    Boolean   @default(false)
  locale          String?
  collaborator    Boolean?  @default(false)
  emailVerified   Boolean?  @default(false)
  refreshToken    String?
  refreshTokenExpires DateTime?
}

// --- SUBSCRIPTION PLAN MODEL ---
model Subscription {
  id             String           @id @default(uuid())
  shop           String
  type           SubscriptionType @default(PRODUCT)
  targetId       String           // Shopify GID for the product or collection
  targetTitle    String
  originalPrice  String
  
  // Using Json type removes the need for JSON.parse/stringify in your code
  plansData      Json             
  shopifyPlanIds Json?            

  shopifyGroupId String?          // gid://shopify/SellingPlanGroup/123
  enabled        Boolean          @default(true)
  
  contracts      Contract[]       // Relation to actual customer contracts
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([shop])
}

// --- BUNDLE MODEL ---
model Bundle {
  id           String   @id @default(uuid())
  shop         String
  title        String
  price        String?  
  discount     String?  
  discountCode String?  
  discountId   String?  // gid://shopify/DiscountAutomaticNode/123
  
  productIds   Json     // Stores GIDs as a JSON array
  
  contracts    Contract[] 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop])
}

// --- CONTRACT MODEL ---
model Contract {
  id              String         @id // gid://shopify/SubscriptionContract/123
  shop            String
  customerId      String?
  customerName    String?
  customerEmail   String?
  status          ContractStatus @default(ACTIVE)
  nextBillingDate DateTime?
  currencyCode    String         @default("USD")
  
  // Explicit Relations
  planId          String?        
  subscription    Subscription?  @relation(fields: [planId], references: [id])
  
  bundleId        String?
  bundle          Bundle?        @relation(fields: [bundleId], references: [id])
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([shop])
  @@index([status])
}