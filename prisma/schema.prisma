// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  firstName   String?
  lastName    String?
  email       String?
  accountOwner Boolean   @default(false)
  locale      String?
  collaborator Boolean?  @default(false)
  emailVerified Boolean? @default(false)
  refreshToken String?
  refreshTokenExpires DateTime?
}

// UPDATED MODEL: Now includes 'shop'
model Subscription {
  id             String   @id @default(uuid())
  shop           String   // <--- ADD THIS LINE (Required for multi-tenancy)
  type           String   // "product" or "collection"
  targetId       String
  targetTitle    String
  originalPrice  String

  // Stores your custom plans as a JSON string
  plansData      String   

  shopifyGroupId String?
  shopifyPlanIds String?  
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
}